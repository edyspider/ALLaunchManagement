{
  "name": "allaunchmanagement",
  "displayName": "AL Launch Management",
  "description": "Manage multiple launch configurations to be used in AL projects",
  "publisher": "EdySpider",
  "icon": "img/icon.png",
  "author": {
    "name": "EdySpider",
    "url": "https://github.com/edyspider"
  },
  "version": "1.3.2",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/edyspider/ALLaunchManagement/issues"
  },
  "categories": [
    "Debuggers",
    "Testing"
  ],
  "keywords": [
    "AL",
    "AL Configuration",
    "AL Launch",
    "Business Central",
    "D365BC",
    "Debug",
    "Dynamics NAV",
    "VSCode Launch",
    "VSCode Debug"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "allaunchmanagement.setLaunchConfiguration",
        "title": "ES-LM: Set Launch.json Configuration"
      },
      {
        "command": "allaunchmanagement.openLaunchConfiguration",
        "title": "ES-LM: Open Launch Configuration"
      },
      {
        "command": "allaunchmanagement.openProjectLaunch",
        "title": "ES-LM: Open Project Launch.json"
      }
    ],
    "configuration": [
      {
        "title": "AL Launch Management",
        "properties": {
          "alLaunchManagement.launchConfigurations": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "configurations": {
                "type": "array",
                "description": "List of pre-defined launch configurations.",
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "configuration"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string",
                      "description": "Name shown in the selection list."
                    },
                    "configuration": {
                      "type": "object",
                      "description": "Configuration copied to launch.json. A configuration with the same name is replaced.",
                      "required": [
                        "name",
                        "type",
                        "request"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "description": "Name of the configuration in launch.json."
                        },
                        "type": {
                          "type": "string",
                          "default": "al"
                        },
                        "request": {
                          "type": "string",
                          "enum": [
                            "launch",
                            "attach",
                            "snapshotInitialize"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            },
            "default": {
              "configurations": [
                {
                  "label": "Local",
                  "configuration": {
                    "name": "Local Machine",
                    "request": "launch",
                    "type": "al",
                    "environmentType": "OnPrem",
                    "server": "http://localhost",
                    "serverInstance": "BC",
                    "authentication": "Windows",
                    "tenant": "default",
                    "breakOnError": true,
                    "launchBrowser": true,
                    "enableLongRunningSqlStatements": true,
                    "enableSqlInformationDebugger": true,
                    "usePublicURLFromServer": true
                  }
                },
                {
                  "label": "Sandbox",
                  "configuration": {
                    "name": "Sandbox",
                    "request": "launch",
                    "type": "al",
                    "environmentType": "Sandbox",
                    "environmentName": "Sandbox",
                    "tenant": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
                    "breakOnError": true,
                    "breakOnRecordWrite": "None",
                    "launchBrowser": true,
                    "enableLongRunningSqlStatements": true,
                    "longRunningSqlStatementsThreshold": 500,
                    "numberOfSqlStatements": 10
                  }
                },
                {
                  "label": "Sandbox Debug Job Queue",
                  "configuration": {
                    "name": "Debug Job Queue",
                    "request": "attach",
                    "type": "al",
                    "environmentType": "Sandbox",
                    "environmentName": "Sandbox",
                    "tenant": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
                    "breakOnNext": "Background",
                    "enableLongRunningSqlStatements": true,
                    "enableSqlInformationDebugger": true,
                    "longRunningSqlStatementsThreshold": 500,
                    "numberOfSqlStatements": 10
                  }
                },
                {
                  "label": "Sandbox Debug API",
                  "configuration": {
                    "name": "Debug API",
                    "request": "attach",
                    "type": "al",
                    "environmentType": "Sandbox",
                    "environmentName": "Sandbox",
                    "tenant": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
                    "breakOnNext": "WebServiceClient"
                  }
                },
                {
                  "label": "Sandbox Snapshot",
                  "configuration": {
                    "name": "Snapshot",
                    "request": "snapshotInitialize",
                    "type": "al",
                    "environmentType": "Sandbox",
                    "environmentName": "Sandbox",
                    "tenant": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
                    "breakOnNext": "WebServiceClient",
                    "snapshotVerbosity": "Full",
                    "executionContext": "DebugAndProfile",
                    "profilingType": "Instrumentation"
                  }
                }
              ]
            },
            "markdownDescription": "Pre-defined `launch.json` configurations for your AL projects. Each item has a `label` (shown in the selection list) and a `configuration` (copied to `launch.json`)."
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "pretest": "npm run compile",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test \"out/test/unit/**/*.test.js\"",
    "test:integration": "vscode-test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.95.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^10.15.0",
    "mocha": "^12.0.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/edyspider/ALLaunchManagement"
  }
}
